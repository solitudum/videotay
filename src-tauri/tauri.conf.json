{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Videotay",
  "version": "0.1.0",
  "identifier": "com.videotay.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Videotay",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": "#0E0F10",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 17 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": [], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "../licenses/*": "licenses/",
      "binaries/build-info.txt": "licenses/ffmpeg-build.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBREYyQzM4MTFFMUZENzYKUldSMi9lRVJPQ3pmdWtGRVpCaUdwTjZiNCtyaU9acng0ZUdSYyttRnl1aDY2RXM4Z2EvcGQrY3IK",
      "endpoints": ["https://github.com/solitudum/videotay/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
