#!/usr/bin/env bash
# Development only: points the Tauri sidecars at the ffmpeg already on PATH, so
# `tauri dev` works without downloading anything. These binaries aren't
# portable, and Homebrew's read-only ones make `tauri build` fail while signing,
# so run scripts/fetch-ffmpeg before building an app.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
out="$root/src-tauri/binaries"
triple="$(rustc -vV | awk '/^host:/ {print $2}')"
mkdir -p "$out"

for tool in ffmpeg ffprobe; do
  ln -sf "$(command -v "$tool")" "$out/$tool-$triple"
done
# The app bundles this beside the licence, so it has to exist.
{
  echo "Development build, using the ffmpeg on PATH. Not for distribution."
  echo
  ffmpeg -hide_banner -version
} > "$out/build-info.txt"
ls -la "$out"
